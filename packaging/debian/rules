#!/usr/bin/make -f

export DH_VERBOSE = 1
export PYBUILD_NAME = bridgelink

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	# Install bore binary during package install
	# The bridgelink install command will handle this at runtime

override_dh_auto_test:
	# Skip tests during build (they require API key)
	true
